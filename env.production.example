# ===========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ===========================================
# File này chứa config cho Cloud Run deployment
# Sử dụng: gcloud run deploy với --set-env-vars

# Application
APP_NAME=VinhPhu
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://your-app-url.run.app

# IMPORTANT: Generate new APP_KEY using: php artisan key:generate --show
# Sau đó lưu vào Secret Manager hoặc env var
APP_KEY=base64:/i9dD9r/FqNIIAKS2c8/tYg7+uCTY2a386yXufYrhD4=

# Database - Neon PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=ep-summer-shape-afzjl9et.c-2.us-west-2.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
# DB_PASSWORD sẽ được set qua Secret Manager (không commit password vào git)
DB_PASSWORD=npg_GM4CPuO2nmWZ
DB_SSLMODE=require

# Hoặc dùng connection string (alternative)
# DB_CONNECTION_URL=postgresql://neondb_owner:PASSWORD@ep-summer-shape-afzjl9et.c-2.us-west-2.aws.neon.tech/neondb?sslmode=require

# Storage - Google Cloud Storage
FILESYSTEM_DISK=gcs
GCS_PROJECT_ID=imperial-medium-485015-k2
GCS_BUCKET=your-bucket-name-here
# GCS_KEY_FILE sẽ được mount vào container

# Cache & Session
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Queue
QUEUE_CONNECTION=database

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter

# Broadcasting
BROADCAST_CONNECTION=log

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD sẽ được set qua Secret Manager
MAIL_PASSWORD=your-email-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# Redis (Optional - không cần cho database cache)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Security
BCRYPT_ROUNDS=12

# Performance
PHP_CLI_SERVER_WORKERS=4
